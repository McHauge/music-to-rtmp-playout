{{define "theme-vars-all"}}
<style>
[data-theme="teal"]     { --accent:#06b6d4; --accent-darker:#0891b2; --accent-rgb:6,182,212;  --bg-from:#080f1a; --bg-to:#0a1628; --orb-1:#06b6d4; --orb-2:#0e7490; --orb-3:#14b8a6; }
[data-theme="gold"]     { --accent:#f59e0b; --accent-darker:#d97706; --accent-rgb:245,158,11; --bg-from:#1a1408; --bg-to:#281e0a; --orb-1:#f59e0b; --orb-2:#b45309; --orb-3:#fbbf24; }
[data-theme="emerald"]  { --accent:#10b981; --accent-darker:#059669; --accent-rgb:16,185,129; --bg-from:#08160f; --bg-to:#0a2818; --orb-1:#10b981; --orb-2:#047857; --orb-3:#34d399; }
[data-theme="rose"]     { --accent:#f43f5e; --accent-darker:#e11d48; --accent-rgb:244,63,94;  --bg-from:#1a0810; --bg-to:#280a16; --orb-1:#f43f5e; --orb-2:#be123c; --orb-3:#fb7185; }
[data-theme="violet"]   { --accent:#8b5cf6; --accent-darker:#7c3aed; --accent-rgb:139,92,246; --bg-from:#120a1a; --bg-to:#1c0e28; --orb-1:#8b5cf6; --orb-2:#6d28d9; --orb-3:#a78bfa; }
[data-theme="sapphire"] { --accent:#3b82f6; --accent-darker:#2563eb; --accent-rgb:59,130,246; --bg-from:#080e1a; --bg-to:#0a1628; --orb-1:#3b82f6; --orb-2:#1d4ed8; --orb-3:#60a5fa; }
[data-theme="crimson"]  { --accent:#dc2626; --accent-darker:#b91c1c; --accent-rgb:220,38,38;  --bg-from:#1a0808; --bg-to:#280a0a; --orb-1:#dc2626; --orb-2:#991b1b; --orb-3:#ef4444; }
[data-theme="slate"]    { --accent:#64748b; --accent-darker:#475569; --accent-rgb:100,116,139;--bg-from:#0c0f14; --bg-to:#141a24; --orb-1:#64748b; --orb-2:#334155; --orb-3:#94a3b8; }
</style>
{{end}}
