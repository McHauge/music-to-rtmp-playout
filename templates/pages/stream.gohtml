{{define "page-stream"}}
<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
{{template "head" .}}
<body data-init="@get('/api/stream/status')">
    {{template "orbs" .}}
    <div class="wrapper">
        {{template "navbar" .}}
        <main class="page">
            <h1 class="page-title">Stream</h1>

            <div class="grid-2">
                <section class="card glass">
                    <h2>Live</h2>
                    {{template "stream-status" .Extra}}
                </section>

                <section class="card glass">
                    <h2>Start a show</h2>
                    <p class="muted">Streaming to <code>{{.Extra.Settings.RTMPURL}}</code></p>
                    <div class="start-row" data-signals="{play:0}">
                        <select data-bind:play>
                            <option value="0" disabled selected>Choose a show…</option>
                            {{range .Extra.Playlists}}
                            <option value="{{.ID}}">{{.Name}}</option>
                            {{end}}
                        </select>
                        <button class="btn btn-primary btn-lg"
                                data-on:click="@post('/api/stream/start?id=' + $play)"
                                {{if .Extra.Running}}disabled{{end}}>
                            ● Start stream
                        </button>
                    </div>
                    <p class="muted small">
                        The stream stays live across songs, breaks, and holds. Configure the
                        RTMP target and background in <a href="/settings">Settings</a>.
                    </p>
                </section>
            </div>
        </main>
    </div>
</body>
</html>
{{end}}
