{{define "page-settings"}}
<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
{{template "head" .}}
<body>
    {{template "orbs" .}}
    <div class="wrapper">
        {{template "navbar" .}}
        <main class="page">
            <h1 class="page-title">Settings</h1>

            <section class="card glass settings-card">
                <form method="POST" action="/api/settings/save" enctype="multipart/form-data" class="settings-form">
                    {{$st := .Extra.Settings}}

                    <h2>RTMP target</h2>
                    <label class="field">
                        <span>RTMP URL</span>
                        <input name="rtmp_url" value="{{$st.RTMPURL}}" placeholder="rtmp://localhost:1935/live/show">
                    </label>
                    <label class="field">
                        <span>Stream key (optional)</span>
                        <input name="stream_key" value="{{$st.StreamKey}}" placeholder="appended to the URL">
                    </label>

                    <h2>Encoder</h2>
                    <label class="field">
                        <span>Background image path</span>
                        <input name="bg_image_path" value="{{$st.BgImagePath}}" placeholder="./assets/bg.png (blank = solid color)">
                    </label>
                    <label class="field">
                        <span>…or upload a background image</span>
                        <input type="file" name="bg_image_file" accept=".png,.jpg,.jpeg,.webp,.bmp">
                        <span class="muted small">Saved to the assets folder; overrides the path above when set.</span>
                    </label>
                    <div class="field-row">
                        <label class="field">
                            <span>Video FPS</span>
                            <input type="number" name="video_fps" value="{{$st.VideoFPS}}" min="1" max="60">
                        </label>
                        <label class="field">
                            <span>Audio bitrate</span>
                            <input name="audio_bitrate" value="{{$st.AudioBitrate}}" placeholder="160k">
                        </label>
                    </div>

                    <h2>Appearance</h2>
                    <label class="field">
                        <span>Theme</span>
                        <select name="theme">
                            {{range .Extra.Themes}}
                            <option value="{{.Name}}" {{if eq .Name $st.Theme}}selected{{end}}>{{.Label}}</option>
                            {{end}}
                        </select>
                    </label>

                    <button class="btn btn-primary" type="submit">Save settings</button>
                </form>
            </section>
        </main>
    </div>
</body>
</html>
{{end}}
