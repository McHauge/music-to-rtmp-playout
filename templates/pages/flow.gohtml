{{define "page-flow"}}
<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
{{template "head" .}}
<body>
    {{template "orbs" .}}
    <div class="wrapper">
        {{template "navbar" .}}
        <main class="page">
            <h1 class="page-title">Flow Builder</h1>

            <div class="grid-sidebar">
                <!-- Shows list -->
                <aside class="card glass">
                    <h2>Shows</h2>
                    <ul class="show-list">
                        {{range .Extra.Playlists}}
                        <li>
                            <a href="/flow?id={{.ID}}"
                               class="show-link {{if and $.Extra.Selected (eq .ID $.Extra.Selected.ID)}}active{{end}}">
                                {{.Name}}
                            </a>
                        </li>
                        {{end}}
                    </ul>
                    <form method="POST" action="/api/flow/create" class="new-show">
                        <input name="name" placeholder="New show name" required>
                        <button class="btn btn-primary btn-sm" type="submit">+ Create</button>
                    </form>
                </aside>

                <!-- Builder -->
                <section class="card glass">
                {{if .Extra.Selected}}
                    {{$pl := .Extra.Selected}}
                    <div class="builder-header">
                        <form method="POST" action="/api/flow/rename" class="rename-form">
                            <input type="hidden" name="id" value="{{$pl.ID}}">
                            <input name="name" value="{{$pl.Name}}">
                            <button class="btn btn-sm btn-outline" type="submit">Rename</button>
                        </form>
                        <div class="builder-meta">
                            <span class="muted">Est. runtime: <strong id="flow-runtime">{{fmtDuration .Extra.RuntimeSec}}</strong></span>
                            <a class="btn btn-sm btn-primary" href="/stream?play={{$pl.ID}}">Go to Stream →</a>
                            <form method="POST" action="/api/flow/delete" onsubmit="return confirm('Delete this show?')">
                                <input type="hidden" name="id" value="{{$pl.ID}}">
                                <button class="btn btn-sm btn-danger" type="submit">Delete show</button>
                            </form>
                        </div>
                    </div>

                    <!-- Bulk add songs -->
                    <div class="bulk-upload">
                        <h3>Bulk add songs</h3>
                        <p class="muted">Upload multiple files at once — each song is appended to the rundown using the options below.</p>
                        <form id="bulk-form" enctype="multipart/form-data" class="bulk-form">
                            <input type="hidden" name="playlist_id" value="{{$pl.ID}}">
                            <input type="file" name="files" accept="audio/*" multiple required>
                            <label class="bulk-spacing">Start
                                <select name="start_mode" title="Auto: songs play through. Manual: playback holds before each song until you press play.">
                                    <option value="auto" selected>Auto-continue</option>
                                    <option value="manual">Manual start</option>
                                </select>
                            </label>
                            <label class="bulk-spacing">
                                <input type="checkbox" name="with_breaks" data-bind:withbreaks checked>
                                Breaks
                            </label>
                            <label class="bulk-spacing">Spacing (s)
                                <input type="number" name="break_sec" value="{{$pl.DefaultBreakSec}}" min="0" max="3600"
                                       data-attr:disabled="!$withbreaks">
                            </label>
                            <button type="button" class="btn btn-sm btn-primary"
                                    data-indicator:bulkbusy
                                    data-attr:disabled="$bulkbusy"
                                    data-on:click="@post('/api/flow/bulk-upload', {contentType: 'form'})">
                                Upload &amp; add to rundown
                            </button>
                            <span data-show="$bulkbusy" class="muted">Uploading…</span>
                        </form>
                        <div id="bulk-log" class="import-log"></div>
                    </div>

                    <!-- Flow items -->
                    {{template "flow-rundown" .Extra.Rundown}}

                    <!-- Add item -->
                    <div class="add-row">
                        <form method="POST" action="/api/flow/item/add" class="add-form">
                            <input type="hidden" name="playlist_id" value="{{$pl.ID}}">
                            <input type="hidden" name="type" value="song">
                            {{template "flow-song-select" .Extra}}
                            <button class="btn btn-sm btn-primary" type="submit">+ Song</button>
                        </form>

                        <form method="POST" action="/api/flow/item/add" class="add-form">
                            <input type="hidden" name="playlist_id" value="{{$pl.ID}}">
                            <input type="hidden" name="type" value="break">
                            <input type="number" name="break_sec" value="{{$pl.DefaultBreakSec}}" min="1" max="3600">
                            <button class="btn btn-sm btn-primary" type="submit">+ Break (s)</button>
                        </form>

                        <form method="POST" action="/api/flow/item/add" class="add-form">
                            <input type="hidden" name="playlist_id" value="{{$pl.ID}}">
                            <input type="hidden" name="type" value="gate">
                            <input name="label" placeholder="Hold label (optional)">
                            <button class="btn btn-sm btn-primary" type="submit">+ Manual hold</button>
                        </form>
                    </div>
                {{else}}
                    <p class="empty">Select a show on the left, or create a new one.</p>
                {{end}}
                </section>
            </div>
        </main>
    </div>
    <script defer src="/static/vendor/sortable.min.js"></script>
    <script defer src="/static/flow-dnd.js"></script>
</body>
</html>
{{end}}
