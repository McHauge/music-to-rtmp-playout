{{define "page-library"}}
<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
{{template "head" .}}
<body data-signals="{url:''}">
    {{template "orbs" .}}
    <div class="wrapper">
        {{template "navbar" .}}
        <main class="page">
            <h1 class="page-title">Library</h1>

            <div class="grid-2">
                <section class="card glass">
                    <h2>Import from YouTube</h2>
                    <p class="muted">Paste a video or playlist URL. Audio is downloaded via yt-dlp.</p>
                    <div class="import-row">
                        <input data-bind-url placeholder="https://youtube.com/watch?v=… or playlist URL">
                        <button class="btn btn-primary"
                                data-on-click="@get('/api/library/import?url=' + encodeURIComponent($url))">
                            Import
                        </button>
                    </div>
                    <div id="import-log" class="import-log"></div>
                </section>

                <section class="card glass">
                    <h2>Upload files</h2>
                    <p class="muted">Add individual audio files (mp3, m4a, opus, wav, …).</p>
                    <form method="POST" action="/api/library/upload" enctype="multipart/form-data" class="upload-form">
                        <input type="file" name="file" accept="audio/*" required>
                        <button class="btn btn-primary" type="submit">Upload</button>
                    </form>
                </section>
            </div>

            <section class="card glass">
                <h2>Tracks</h2>
                {{template "track-list" .Extra}}
            </section>
        </main>
    </div>
</body>
</html>
{{end}}
