{{/* clip-controls is the trigger + pre-listen pair every clip tile carries,
     shared by the stream console's side grid and the Soundboard page (which
     adds a delete form of its own). Data: one SoundboardClip. */}}
{{define "clip-controls"}}
<button class="clip-btn" data-on:click="@post('/api/soundboard/trigger?id={{.ID}}')">
    🔊 {{.Name}}
</button>
<button class="clip-preview preview-btn" type="button" data-track="{{.ID}}" data-cue
        data-src="/api/soundboard/preview?id={{.ID}}"
        onclick="previewToggle(this)" title="Pre-listen">▶</button>
{{end}}

{{define "stream-soundboard"}}
<div id="stream-soundboard" class="clip-grid clip-grid-side">
    {{range .}}
    <div class="clip">
        {{template "clip-controls" .}}
    </div>
    {{else}}
    <p class="empty">No clips yet. Add some on the <a href="/soundboard">Soundboard</a> page.</p>
    {{end}}
</div>
{{end}}
