# Copy to .env and adjust. All values are optional (defaults shown).

# Server
HOST=
PORT=8080

# Session signing key — CHANGE THIS in production.
SESSION_SECRET=change-me-in-production

# First-run admin bootstrap (optional). Leave unset to create the admin
# account via the UI setup screen on first visit (recommended). If you set
# these, pick a strong password — they create a real account.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Storage (mounted as volumes in Docker)
DB_PATH=./data/playout.db
MEDIA_DIR=./media
SOUNDBOARD_DIR=./soundboard
ASSETS_DIR=./assets
MAX_UPLOAD_MB=200

# External tools. By default the app is self-contained: it looks in BIN_DIR
# (./bin) first, then falls back to PATH. Populate ./bin with:
#   Windows:  pwsh ./scripts/fetch-tools.ps1
#   Linux/Mac: ./scripts/fetch-tools.sh
# The Docker image ships these vendored in /app/bin already.
BIN_DIR=./bin
# Uncomment to force a specific binary (overrides BIN_DIR + PATH):
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp

# Default RTMP target. With the bundled MediaMTX relay, push to localhost and
# configure the real upstream in mediamtx.yml. Editable later in the UI.
RTMP_URL=rtmp://localhost:1935/live/show
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=10
AUDIO_BITRATE=160k
BG_IMAGE_PATH=./assets/bg.png

# UI theme: teal gold emerald rose violet sapphire crimson slate
THEME=teal
